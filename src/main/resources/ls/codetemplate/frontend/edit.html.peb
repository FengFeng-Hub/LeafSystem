<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>编辑页面</title>
</head>
<body>
<div class="ls-card ls-container">
    <div style="height: 50px;position: sticky;top: 24px;z-index: 1;">
        <a-button size="small" @click="onBack"><a-icon type="rollback"></a-icon> 返回</a-button>
        <a-button v-if="operate !== 'View'" type="primary" size="small" @click="savaForm" style="margin-left: 10px;"><a-icon type="save"></a-icon> 保存</a-button>
    </div>
    <a-form-model :model="formData" :rules="formDataRules" ref="form">
        <a-form-model-item v-if="operate !== 'Add'" label="ID" :label-col="{span: 3}" :wrapper-col="{span: 20}">
            <a-input v-model="id" disabled/>
        </a-form-model-item>
{# 生成表单 #}
{% for item in columnInfoList %}
{% if not item.isPrimaryKey and item.isEdit %}
        <a-form-model-item label="{$ item.columnTitle $}" prop="{$ item.columnUnderLine $}" :label-col="{ span: 3 }" :wrapper-col="{ span: 20 }">
{% if item.ControlType == '2' %}
            <a-input-password v-model="formData.{$ item.columnUnderLine $}" :disabled="formDisabled"/>
{% elseif item.ControlType == '3' %}
            <a-date-picker
                v-model="formData.{$ item.columnUnderLine $}"
                :disabled="formDisabled"
                format="yyyy年MM月DD日"
                value-format="yyyy-MM-DD"
                style="width: 200px;"
            />
{% elseif item.ControlType == '4' %}
            <a-date-picker
                v-model="formData.{$ item.columnUnderLine $}"
                :disabled="formDisabled"
                format="yyyy年MM月DD日"
                value-format="yyyy-MM-DD"
                show-time
                style="width: 200px;"
            />
{% elseif item.ControlType == '5' %}
            <a-select v-model="formData.{$ item.columnUnderLine $}" :disabled="formDisabled" style="width: 100px;">
                <a-select-option value="1">选项1</a-select-option>
                <a-select-option value="2">选项2</a-select-option>
            </a-select>
{% elseif item.ControlType == '6' %}
            <a-switch
                :checked="formData.{$ item.columnUnderLine $} === '1'"
                :disabled="formDisabled"
                @change="formData.{$ item.columnUnderLine $} = formData.{$ item.columnUnderLine $} === '1'?'0':'1'"
            />
{% else %}
            <a-input v-model="formData.{$ item.columnUnderLine $}" :disabled="formDisabled"/>
{% endif %}
        </a-form-model-item>
{% endif %}
{% endfor %}
    </a-form-model>
</div>
</body>
<script>
    function init(props, params) {
        let _this = null;

        new Vue({
            el: ".ls-container",
            data: {
                operate: params.operate,
                id: params.id,
                // 禁用表单
                formDisabled: false,
                // 表单数据
                formData: {
{% for item in columnInfoList %}
{% if not item.isPrimaryKey and item.isEdit %}
                    {$ item.columnUnderLine $}: null,
{% endif %}
{% endfor %}
                },
                // 表单验证
                formDataRules: {
{% for item in columnInfoList %}
{% if not item.isPrimaryKey and item.isNotNull %}
                    {$ item.columnUnderLine $}: [
                        { required: true, message: '请输入', trigger: 'change' },
                    ],
{% endif %}
{% endfor %}
                }
            },
            created() {
                _this = this;

                if (this.operate === 'View') {
                    this.formDisabled = true;
                }

                if (this.operate !== 'Add') {
                    Ajax.get({
                        url: '{$ apiRootAddress $}get{$ className $}List',
                        param: {
                            {$ primaryKeyColumn $}: _this.id
                        },
                        success(result) {
                            if(result.IsSuccess === '1' && result.data.length > 0) {
                                _this.formData = result.data[0];
                            } else {
                                _this.$message.error(result.Msg);
                            }
                        }
                    });
                }
            },
            methods: {
                // 返回
                onBack() {
                    QiankunUtil.toPage(props.parentUrl + 'index.html', { backParams: params.backParams });
                },
                // 保存表单
                savaForm() {
                    this.$refs.form.validate(valid => {
                        if (valid) {
                            let param = this.formData;

                            if (this.operate === 'Edit') {
                                param.{$ primaryKeyColumn $} = this.id;
                            }

                            Ajax.post({
                                url: '{$ apiRootAddress $}update{$ className $}?UpdateType=' + this.operate,
                                param: param,
                                success(result) {
                                    if(result.IsSuccess === '1') {
                                        _this.$message.success('操作成功');
                                        _this.onBack();
                                    } else {
                                        _this.$message.error(result.Msg);
                                    }
                                }
                            });
                        } else {
                            this.$message.error('表单校验失败，请检查输入');
                        }
                    });
                }
            }
        });
    }

    // 获取qiankun子应用生命周期
    QiankunUtil.getLifecycles({
        mount(props) {
            init(props, props.params);
        }
    });
</script>
</html>